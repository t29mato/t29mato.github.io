_site
.sass-cache
.jekyll-cache
.jekyll-metadata
# Anchored: bundler installs to ./vendor/bundle at the repo root. Unanchored,
# `vendor` matches at any depth — which silently swallowed assets/vendor/leaflet/,
# so Leaflet was never committed and /hikes/ shipped with a 404 for its map library.
/vendor
.idea
.vercel

# Raw GPX exports (YAMAP / Strava / Yamareco) are committed, so any machine
# that clones this repo can run _scripts/build-hikes.mjs without first
# fetching 25 MB out of Drive. `_gpx` is underscore-prefixed, so Jekyll never
# builds or serves it — it lives in the repo the way _data/ does, not on the
# site.
